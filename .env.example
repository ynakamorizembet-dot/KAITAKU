# このファイルは雛形です。実際の値は.env.local(Git管理外)に記入してください。
# 運営(ボス)側で用意する値のみここに含みます。ユーザーのAPIキーはDB側で暗号化保存する想定で、.envには含めません。
# 取得手順はREADME.mdの「セットアップ手順(ボス作業)」を参照してください。
# SUPABASE_SERVICE_ROLE_KEYは絶対に公開しない・ブラウザに渡さないこと(lib/supabase/admin.ts以外から読み込まない)。

# 認証・DB(Supabase等、無料枠を第一候補とする)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ユーザーのBYOK APIキー(api_keys.encrypted_key)を暗号化する鍵。32byte・base64。
# 生成例: openssl rand -base64 32
# 絶対にGitにコミットしない・使い回さない。紛失すると既存の暗号化済みキーは復号できなくなる。
ENCRYPTION_KEY=

# メールOAuth連携用(Google Cloud Console / Microsoft Entra で発行)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# フェーズ2:決済(Stripe)・SMS送信業者キー(導入時に追記、ボス承認後に有効化)
# STRIPE_SECRET_KEY=
# SMS_PROVIDER_API_KEY=
